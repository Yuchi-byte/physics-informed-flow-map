reward_experiments/
# Generated training artifacts inside vendored reference packages
trained_models/
**/trained_models/

# Generated media (samples, plots, animations). Doc/README assets are committed
# explicitly with `git add -f` and remain tracked.
*.gif
*.mp4
*.webp

# Data
marmousi/
csv/
data/*
# The inversion benchmark is script-regenerated (deterministic seeds; velocity maps are
# kept after bulk deletion, spec §9.5) — only its hand-pinned provenance input is tracked.
!data/inversion_bench/
data/inversion_bench/*
!data/inversion_bench/legacy_6044_provenance.json

# Weights & Biases
wandb/

# Environment / secrets (template stays tracked as .secrets.example)
.env
.env*
.secrets

# Misc
*.log
*.tmp

# Subagent-driven-development scratch (briefs, reports, review packages)
.superpowers/

# Locally saved reference papers (committed assets live under packages/*/assets)
docs/research/*.pdf
experiments/0002_fwi_tilting/poc_result.png
